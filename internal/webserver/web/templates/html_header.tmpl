{{define "header"}}<!doctype html>
<html lang="{{ currentLanguage }}" class="h-100" data-bs-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">

	<script src="./assets/dist/js/jquery.min.js"></script>
	<script src="./assets/dist/js/bootstrap.bundle.min.js"></script>
	<link href="./assets/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="apple-touch-icon" sizes="180x180" href="./favicon-apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="./favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="./favicon-16x16.png">
	<link rel="manifest" href="./site.webmanifest">
        <link href="./css/min/gokapi.min.{{ template "css_main"}}.css" rel="stylesheet">
	<link href="./assets/dist/icons/bootstrap-icons.min.css" rel="stylesheet">
	<!-- Liquid glass design system. Loaded after the main stylesheet so it can override it. -->
	<link href="./css/theme.css" rel="stylesheet">
	<script src="./js/theme.js"></script>
	<script src="./js/min/all_public.min.js"></script>
{{ if .IsAdminView }}
        <title>{{.PublicName}} Admin</title>
	<script src="./assets/dist/js/dropzone.min.js?v={{ template "js_dropzone_version"}}"></script>
	<script src="./assets/dist/js/clipboard.min.js"></script>
	<script src="./assets/dist/js/datatables.min.js"></script>
	<script src="./assets/dist/js/qrcode.min.js"></script>
	<script src="./assets/dist/js/flatpickr.min.js"></script>
	<link  href="./assets/dist/css/dropzone.min.v2.css" rel="stylesheet">
	<link  href="./assets/dist/css/datatables.min.css" rel="stylesheet">
	<link  href="./assets/dist/css/flatpickr.min.css" rel="stylesheet">
	<link  href="./assets/dist/css/flatpickr.dark.min.css" rel="stylesheet">
	<style>
		.masthead-brand {
			float: left;
		}
		.nav-masthead {
			float: right;
		}
	</style>
    {{ if .CustomContent.UseCustomCss }}
	<link  href="./custom/custom.v{{.CustomContent.Version}}.css" rel="stylesheet">
    {{ end }}
{{ else }}
   {{ if .IsDownloadView }}
       {{ if .IsPasswordView }}
          <title>{{.PublicName}}: {{ tr "downloadpw.title" }}</title>
	  <meta name="title" content="{{.PublicName}}">
    	  <meta name="description" content="{{ tr "downloadpw.title" }}">
    	  
    	  <meta property="og:title" content="{{.PublicName}}"/>
  	  <meta property="og:description" content="{{ tr "downloadpw.title" }}"/>
       {{ else }}
          <title>{{.PublicName}}: {{.Name}}</title>
	  <meta name="title" content="{{.PublicName}}: {{.Name}}">
    	  <meta name="description" content="{{.Size}}">
    	  
    	  <meta property="og:title" content="{{.Name}}"/>
  	  <meta property="og:description" content="{{.Size}}"/>
       {{end }}
  	  <meta property="og:url" content="{{.BaseUrl}}"/>
   {{ else }}
         <title>{{.PublicName}}</title>
   {{end }}
    {{ if .CustomContent.UseCustomCss }}
         <link  href="./custom/custom.v{{.CustomContent.Version}}.css" rel="stylesheet">
    {{ end }}
         <script src="./js/min/end2end_download.min.{{ template "js_e2eversion"}}.js"></script>
{{end}}
  </head>
  <body class="d-flex h-100 text-center">
<!-- Global toolbar: theme switcher and language switcher, available on every rendered page -->
<div id="gk-toolbar" class="gk-toolbar" role="group" aria-label="{{ tr "common.language" }}">
  <button type="button" id="gk-theme-toggle" class="gk-toolbar-btn" onclick="gokapiToggleTheme()"
          title="{{ tr "common.toggleTheme" }}" aria-label="{{ tr "common.toggleTheme" }}">
    <i class="bi bi-moon-stars-fill" id="gk-theme-icon" aria-hidden="true"></i>
  </button>
  <div class="gk-lang-switch">
    {{ $current := currentLanguage }}
    {{ range availableLanguages }}
    <a class="gk-lang-link {{ if eq .Code $current }}active{{ end }}" href="./setLanguage?lang={{ .Code }}"
       title="{{ .Name }}" lang="{{ .Code }}">{{ .Name }}</a>
    {{ end }}
  </div>
</div>
{{ if .IsAdminView }}
   {{ if .IsUserTabAvailable }}
<div class="gk-user-badge">
  <span class="badge bg-secondary opacity-75">
    <i class="bi bi-person-fill"></i> {{.ActiveUser.Name}}
  </span>
</div>
  {{ end }}
  <div class="d-flex w-100 h-100 p-3 mx-auto flex-column">
      <header class="masthead mb-auto">
        <div  style="max-width: 80em;  margin: 0 auto;"  class="inner">
          <h1>{{.PublicName}}</h1>
          <nav class="nav nav-masthead justify-content-center">
            <a class="nav-link {{ if eq .ActiveView 0}}active{{ end }}" href="./admin">{{ tr "nav.upload" }}</a>
            {{ if .ActiveUser.HasPermissionCreateFileRequests }}
            <a class="nav-link {{ if eq .ActiveView 4 }}active{{ end }}" href="./filerequests">{{ tr "nav.fileRequests" }}</a>
            {{ end }}
            {{ if and .ActiveUser.HasPermissionManageUsers .IsUserTabAvailable }}
            <a class="nav-link {{ if eq .ActiveView 3 }}active{{ end }}" href="./users">{{ tr "nav.users" }}</a>
            {{ end }}
            {{ if .ShowApiMenu }}
            <a class="nav-link {{ if eq .ActiveView 2 }}active{{ end }}" href="./apiKeys">{{ tr "nav.api" }}</a>
            {{ end }}
            {{ if .ActiveUser.HasPermissionManageLogs }}
            <a class="nav-link {{ if eq .ActiveView 1 }}active{{ end }}" href="./logs">{{ tr "nav.status" }}</a>
            {{ end }}
            {{ if .IsLogoutAvailable }}<a class="nav-link" href="#" onclick="doLogout()">{{ tr "nav.logout" }}</a>{{ end }}
          </nav>
        </div>
      </header>
  <main style="margin-top: 2rem">
{{ else }}
  <div class="d-flex w-100 h-100 p-3 mx-auto flex-column">
  <header class="mb-auto">
    <div>
      <h1><a href="/index" style="text-decoration: none;display: block;">{{.PublicName}}</a></h1>
    </div>
  </header>
  <main>
{{ end }}
{{end}}
