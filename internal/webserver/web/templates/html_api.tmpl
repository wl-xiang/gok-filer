{{ define "api" }}{{ template "header" . }}
<div class="row">
    <div class="col">
        <div id="container" class="card" style="width: 80%">
            <div class="card-body">
		<div class="container">
		  <div class="row mb-4">
		    <div class="col">
		    </div>
		    <div class="col text-center">
		      <h3 class="card-title mb-0">{{ tr "api.title" }}</h3>
		    </div>
		    <div class="col text-end">
		      <button id="button-newapi" class="btn btn-outline-light" onclick="newApiKey()">
                    <i class="bi bi-plus-circle-fill"></i>
                </button>
		    </div>
		  </div>
		</div>
		
                {{ tr "api.intro.visit" }} <a target="_blank" href="./apidocumentation">{{ tr "api.intro.link" }}</a> {{ tr "api.intro.after" }}<br>{{ tr "api.intro.hint" }}
                <br>
                <br>
                <div class="table-responsive">
                    <table class="table table-dark">
                        <thead>
                            <tr>
                                <th scope="col">{{ tr "api.table.name" }}</th>
                                <th scope="col">{{ tr "api.table.key" }}</th>
                                <th scope="col">{{ tr "api.table.lastUsed" }}</th>
            			<th scope="col">{{ tr "api.table.permissions" }}
                                    <button type="button"
                                        class="btn btn-sm btn-link text-white-50 p-0 ms-1 align-baseline"
                                        id="apiPermLegendBtn"
                                        data-bs-toggle="popover"
                                        data-bs-placement="top"
                                        data-bs-html="true"
                                        data-bs-trigger="focus"
                                        data-bs-content='
                                            <table class="table table-sm table-dark mb-0" style="font-size:0.85em">
                                              <tbody>
                                                <tr><td><i class="bi bi-eye"></i></td><td>{{ tr "api.legend.listUploads" }}</td></tr>
                                                <tr><td><i class="bi bi-file-earmark-plus"></i></td><td>{{ tr "api.legend.uploadFiles" }}</td></tr>
                                                <tr><td><i class="bi bi-pencil"></i></td><td>{{ tr "api.legend.editUploads" }}</td></tr>
                                                <tr><td><i class="bi bi-trash3"></i></td><td>{{ tr "api.legend.deleteUploads" }}</td></tr>
                                                <tr><td><i class="bi bi-recycle"></i></td><td>{{ tr "api.legend.replaceUploads" }}</td></tr>
                                                <tr><td><i class="bi bi-box-arrow-in-down"></i></td><td>{{ tr "api.legend.downloadFiles" }}</td></tr>
                                                <tr><td><i class="bi bi-file-earmark-arrow-up"></i></td><td>{{ tr "api.legend.fileRequests" }}</td></tr>
                                                <tr><td><i class="bi bi-people"></i></td><td>{{ tr "api.legend.manageUsers" }}</td></tr>
                                                <tr><td><i class="bi bi-card-list"></i></td><td>{{ tr "api.legend.manageLogs" }}</td></tr>
                                                <tr><td><i class="bi bi-sliders2"></i></td><td>{{ tr "api.legend.manageApi" }}</td></tr>
                                              </tbody>
                                            </table>'
                                        title="{{ tr "api.legend.title" }}"
                                        tabindex="0"
                                        aria-label="{{ tr "api.legend.title" }}">
                                        <i class="bi bi-question-circle"></i>
                                    </button>
                                </th>
{{ if .ActiveUser.HasPermissionManageApi }}
            			<th scope="col">{{ tr "api.table.user" }}</th>
{{ end }}
                                <th scope="col">{{ tr "api.table.actions" }}</th>
                            </tr>
                        </thead>
                        <tbody id="apitable">
{{ range .ApiKeys }}
                            <tr id="row-{{ .PublicId }}">
                                <td id="friendlyname-{{ .PublicId }}" onClick="addFriendlyNameChange('{{ .PublicId }}')">{{ .FriendlyName }}</td>
                                <td><div class="font-monospace">{{ .GetRedactedId }}</div></td>
            			<td><span id="cell-lastused-{{ .PublicId }}"></span></td>
				   <script>insertDateWithNegative({{ .LastUsed }}, "cell-lastused-{{ .PublicId }}");</script>
                                            <td class="prevent-select">
						<i id="perm_view_{{ .PublicId }}" class="bi bi-eye {{if not .HasPermissionView}}perm-notgranted{{else}}perm-granted{{end}}" title="{{ tr "api.legend.listUploads" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_VIEW", "perm_view_{{ .PublicId }}");'></i>
						
						<i id="perm_upload_{{ .PublicId }}" class="bi bi-file-earmark-plus {{if not .HasPermissionUpload}}perm-notgranted{{else}}perm-granted{{end}}" title="{{ tr "api.legend.uploadFiles" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_UPLOAD", "perm_upload_{{ .PublicId }}");'></i>
						
						<i id="perm_edit_{{ .PublicId }}" class="bi bi-pencil {{if not .HasPermissionEdit}}perm-notgranted{{else}}perm-granted{{end}}" title="{{ tr "api.legend.editUploads" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_EDIT", "perm_edit_{{ .PublicId }}");'></i>
						
						<i id="perm_delete_{{ .PublicId }}" class="bi bi-trash3 {{if not .HasPermissionDelete}}perm-notgranted{{else}}perm-granted{{end}}" title="{{ tr "api.legend.deleteUploads" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_DELETE", "perm_delete_{{ .PublicId }}");'></i>
						
						
						<i id="perm_replace_{{ .PublicId }}" class="bi bi-recycle {{if not (index $.UserMap .UserId).HasPermissionReplace}}perm-unavailable perm-nochange{{ else }}{{if not .HasPermissionReplace}}perm-notgranted{{else}}perm-granted{{end}}{{end}}" title="{{ tr "api.legend.replaceUploads" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_REPLACE", "perm_replace_{{ .PublicId }}");'></i>
						
						<i id="perm_download_{{ .PublicId }}" class="bi bi-box-arrow-in-down {{if not .HasPermissionDownload}}perm-notgranted{{else}}perm-granted{{end}}" title="{{ tr "api.legend.downloadFiles" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_DOWNLOAD", "perm_download_{{ .PublicId }}");'></i>
			
						
						<i id="perm_manage_file_requests_{{ .PublicId }}" class="bi bi-file-earmark-arrow-up {{if not (index $.UserMap .UserId).HasPermissionCreateFileRequests}}perm-unavailable perm-nochange{{ else }}{{if not .HasPermissionManageFileRequests}}perm-notgranted{{else}}perm-granted{{end}}{{end}}" title="{{ tr "api.legend.fileRequests" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_MANAGE_FILE_REQUESTS", "perm_manage_file_requests_{{ .PublicId }}");'></i>
						
						<i id="perm_users_{{ .PublicId }}" class="bi bi-people {{if not (index $.UserMap .UserId).HasPermissionManageUsers}}perm-unavailable perm-nochange{{ else }}{{if not .HasPermissionManageUsers}}perm-notgranted{{else}}perm-granted{{end}}{{end}}" title="{{ tr "api.legend.manageUsers" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_MANAGE_USERS", "perm_users_{{ .PublicId }}");'></i>
						
						<i id="perm_logs_{{ .PublicId }}" class="bi bi-card-list {{if not (index $.UserMap .UserId).HasPermissionManageLogs}}perm-unavailable perm-nochange{{ else }}{{if not .HasPermissionManageLogs}}perm-notgranted{{else}}perm-granted{{end}}{{end}}" title="{{ tr "api.legend.manageLogs" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_MANAGE_LOGS", "perm_logs_{{ .PublicId }}");'></i>
						
						<i id="perm_api_{{ .PublicId }}" class="bi bi-sliders2 {{if not .HasPermissionApiMod}}perm-notgranted{{else}}perm-granted{{end}}" title="{{ tr "api.legend.manageApi" }}" onclick='changeApiPermission("{{ .PublicId }}","PERM_API_MOD", "perm_api_{{ .PublicId }}");'></i>
            				</td>
{{ if $.ActiveUser.HasPermissionManageApi }}
            			 <td>{{(index $.UserMap .UserId).Name}}</td>
{{ end }}
                                <td><button id="delete-{{ .PublicId }}" type="button" class="btn btn-outline-danger btn-sm" onclick="deleteApiKey('{{ .PublicId }}')" title="{{ tr "common.delete" }}"><i class="bi bi-trash3"></i></button></td>
                            </tr>
{{ end }}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
	<div id="toastnotification" class="toastnotification" data-default="{{ tr "api.toast.keyCopied" }}">Toast Text</div>
    </div>
</div>
<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
<script>
	var userName = "{{.ActiveUser.Name}}";
        var canViewOtherApiKeys = {{.ActiveUser.HasPermissionManageApi }};
        var canReplaceFiles = {{.ActiveUser.HasPermissionReplace }};
        var canManageUsers = {{.ActiveUser.HasPermissionManageUsers }};
        var canViewSystemLog = {{.ActiveUser.HasPermissionManageLogs }};
        var canCreateFileRequest = {{.ActiveUser.HasPermissionCreateFileRequests }};

	(function () {
		var el = document.getElementById('apiPermLegendBtn');
		if (el) {
			new bootstrap.Popover(el, { sanitize: false });
		}
	})();
</script>

        
{{ template "pagename" "ApiOverview"}}
{{ template "customjs" .}}

{{ template "footer" true }}
{{ end }}
