{{ define "admin" }}{{ template "header" . }}
 
      <div class="row">
        <div class="col">
		<div id="container" class="card" style="width: 80%">
		  <div class="card-body">
		    <h3 class="card-title">{{ tr "admin.title" }}</h3>
		    <br>
		    <p class="card-text">
		    
			<form action="./uploadChunk" class="dropzone upload-box text-center w-100" id="uploaddropzone">
				<div class="dz-message">
{{ if .EndToEndEncryption }}
				    <p id="uploadBoxTitle" class="mb-2 fs-5">{{ tr "admin.upload.wait" }}</p>
				    <p id="uploadBoxSubtitle" class="mb-0 opacity-75">{{ tr "admin.upload.loadingE2e" }}</p>
{{ else }}
				    <p id="uploadBoxTitle" class="mb-2 fs-5">{{ tr "admin.upload.dragDrop" }}</p>
				    <p id="uploadBoxSubtitle" class="mb-0 opacity-75">{{ tr "admin.upload.orPaste" }}</p>
{{ end }}
				</div>
			</form>
		
		<div id="uploadstatus" class="container uploads-container">
		</div>		
		<p></p>
		
		<br>
		<div class="upload-options-grid">


		  <div class="upload-option-card">
		    <div class="upload-option-header">
		      <div class="d-flex align-items-center gap-2">
		        <i class="bi bi-arrow-down-circle upload-option-icon"></i>
		        <span class="upload-option-label">{{ tr "admin.option.downloadLimit" }}</span>
		      </div>
		      <div class="form-check form-switch mb-0">
		        <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		               name="enableDownloadLimit" id="enableDownloadLimit"
		               onchange="checkBoxChanged(this, 'allowedDownloads')" checked
		               aria-label="{{ tr "admin.option.downloadLimit" }}">
		      </div>
		    </div>
		    <div class="input-group upload-option-input-group">
		      <input type="number" class="form-control admin-input" value="1"
		             name="allowedDownloads" id="allowedDownloads" min="1"
		             style="text-align: right;" data-allow-regular-paste>
		      <span class="input-group-text upload-option-suffix">{{ tr "admin.option.downloads" }}</span>
		    </div>
		  </div>

		  <div class="upload-option-card">
		    <div class="upload-option-header">
		      <div class="d-flex align-items-center gap-2">
		        <i class="bi bi-calendar-x upload-option-icon"></i>
		        <span class="upload-option-label">{{ tr "admin.option.expiry" }}</span>
		      </div>
		      <div class="form-check form-switch mb-0">
		        <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		               name="enableTimeLimit" id="enableTimeLimit"
		               onchange="checkBoxChanged(this, 'expiryDays')" checked
		               aria-label="{{ tr "admin.option.expiry" }}">
		      </div>
		    </div>
		    <div class="input-group upload-option-input-group">
		      <input type="number" class="form-control admin-input" value="14"
		             name="expiryDays" id="expiryDays" min="1" max="100000"
		             style="text-align: right;" data-allow-regular-paste>
		      <span class="input-group-text upload-option-suffix">{{ tr "admin.option.days" }}</span>
		    </div>
		  </div>

		  <div class="upload-option-card">
		    <div class="upload-option-header">
		      <div class="d-flex align-items-center gap-2">
		        <i class="bi bi-key upload-option-icon"></i>
		        <span class="upload-option-label">{{ tr "admin.option.password" }}</span>
		      </div>
		      <div class="form-check form-switch mb-0">
		        <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		               name="enablePassword" id="enablePassword"
		               onchange="checkBoxChanged(this, 'password')"
		               aria-label="{{ tr "admin.option.password" }}">
		      </div>
		    </div>
		    <input class="form-control admin-input upload-option-input-group" value=""
		           name="password" id="password" placeholder="{{ tr "admin.option.noPassword" }}" disabled
		           data-allow-regular-paste>
		  </div>

		</div>
<div id="errordiv" class="alert alert-danger" style="display:none">
  <span id="errormessage" ></span>
</div>
		<br><br>
		<div class="table-responsive">
			<table id="maintable" class="table table-dark">
				<thead>
					<tr>
						<th scope="col" style="text-align: center;">{{ tr "admin.table.filename" }}</th>
						<th scope="col" style="text-align: center;">{{ tr "admin.table.size" }}</th>
						<th scope="col" style="text-align: center;">{{ tr "admin.table.downloadsRemaining" }}</th>
						<th scope="col" style="text-align: center;">{{ tr "admin.table.storedUntil" }}</th>
						<th scope="col" style="text-align: center;">{{ tr "admin.table.downloads" }}</th>
						<th scope="col" style="text-align: center;">{{ tr "admin.table.id" }}</th>
						<th scope="col" style="text-align: center; min-width:13em;">{{ tr "admin.table.actions" }}</th>
					</tr>
				</thead>
				<tbody id="downloadtable">
{{ range .Items }}
	{{ if not (or .IsPendingDeletion .IsFileRequest) }}	
		{{ if  or (gt .ExpireAt $.TimeNow) (.UnlimitedTime) }}
			{{ if or (gt .DownloadsRemaining 0) (.UnlimitedDownloads) }}
					<tr id="row-{{ .Id }}">
						<td id="cell-name-{{ .Id }}">{{ .Name }}</td>
						<td data-order="{{ .SizeBytes }}">{{ .Size }}</td>
				{{ if .UnlimitedDownloads }}
						<td>{{ tr "common.unlimited" }}</td>
				{{ else }}
						<td id="cell-downloadsRemaining-{{ .Id }}">{{ .DownloadsRemaining }}</td>
				{{ end }}
				{{ if .UnlimitedTime }}
						<td>{{ tr "common.unlimited" }}</td>
				{{ else }}
						<td><span id="cell-expireatstring-{{ .Id }}"></span></td>
						 <script>insertFormattedDate({{ .ExpireAt }}, "cell-expireatstring-{{ .Id }}");</script>
				{{ end }}
						<td id="cell-downloads-{{ .Id }}">{{ .DownloadCount }}</td>
						<td><a id="url-href-{{ .Id }}" target="_blank" href="{{ .UrlDownload }}">{{ .Id }}</a>{{ if .IsPasswordProtected }}  <i title="{{ tr "admin.tooltip.passwordProtected" }}" class="bi bi-key"></i>{{ end }}</td>
						<td>
						<div class="btn-toolbar justify-content-end" role="toolbar" >
						  <div class="btn-group me-2" role="group">
						     {{ template "admin_button_copyurl" (newAdminButtonContext . $.ActiveUser)}}
						     {{ template "admin_button_share" (newAdminButtonContext . $.ActiveUser)}}
						  </div>
						  <div class="btn-group" role="group">
						     {{ template "admin_button_download" (newAdminButtonContext . $.ActiveUser) }}
						     {{ template "admin_button_edit" (newAdminButtonContext . $.ActiveUser) }}
						     {{ template "admin_button_delete" (newAdminButtonContext . $.ActiveUser) }}
						 </div>
						</div></td>
					</tr>
			{{ end }}
		{{ end }}
	{{ end }}
{{ end }}
				</tbody>
			</table>
		      </div>
		  </div>
		</div>
	    </div>
   	 </div>
	
	{{ template "admin_modal_edit" }}
	

	<div id="toastnotification" class="toastnotification" data-default="{{ tr "admin.toast.urlCopied" }}">Toast Text</div>
	<div id="toastnotificationUndo" class="toastnotification">
	  {{ tr "admin.toast.fileDeleted" }} <span id="toastFilename"></span>
  	   <span id="toastUndoButton" class="toast-undo" onclick="handleUndo(this)">{{ tr "admin.toast.restore" }}</span>
	</div>
	<div id="toastDeprecation" class="toastnotification toastdeprecation">
	  {{ tr "admin.toast.deprecated" }}
	</div>
	<div id="qroverlay">
	  <div id="qrcode"></div>
	</div>

	<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
	<script>
	
	initDropzone();

	Dropzone.options.uploaddropzone["maxFilesize"] = {{ .MaxFileSize }};
	Dropzone.options.uploaddropzone["timeout"] = 1200000;
	Dropzone.options.uploaddropzone["chunking"] = true;
	Dropzone.options.uploaddropzone["chunkSize"] = {{ .ChunkSize }} * 1024 * 1024;
	Dropzone.options.uploaddropzone["parallelUploads"] = 1;
	Dropzone.options.uploaddropzone["parallelChunkUploads"] = {{.MaxParallelUploads}};
	Dropzone.options.uploaddropzone["forceChunking"] = true;
	Dropzone.options.uploaddropzone["retryChunksLimit"] = 3;
	Dropzone.options.uploaddropzone["retryChunks"] = true;
	Dropzone.options.uploaddropzone["previewsContainer"] = false;
	
	$(document).ready(function () {
	
	    $('#maintable').DataTable({
	    "responsive": true,
	    "order": [], // disables initial sorting
	    "columnDefs": [ {
		"targets": 6,
		"orderable": false
		} ],
	    "paging": false,
	    "language": {
	      "info": "{{ tr "admin.datatable.filesStored" }}",
	      "emptyTable": "{{ tr "admin.datatable.empty" }}",
	      "infoEmpty": "",
	    }
	    });
	});
	
	registerChangeHandler();
		
	var canReplaceOwnFiles = {{.ActiveUser.HasPermissionReplace}};
	setUploadDefaults();
	
{{ if .ShowDeprecationNotice }}
	showDeprecationNotice();
{{ end }}
	
	</script>
        <script src="./js/min/uuid.min.js"></script>

{{ if .EndToEndEncryption }}
        <script src="./js/min/wasm_exec.min.js"></script>
	<script src="./js/min/end2end_admin.min.{{ template "js_e2eversion"}}.js"></script>
	<script>
	{{ if .IncludeFilename }} 
		const IncludeFilename = true;
	{{ else }}
		const IncludeFilename = false;
	{{ end }}
		isE2EEnabled = true;
	
		Blob.prototype.arrayBuffer ??= function() {
		    return new Response(this).arrayBuffer()
		}
		
		checkIfE2EKeyIsSet();
	</script>
{{ end }}
        
        
{{ template "pagename" "FileRequest"}}
{{ template "customjs" .}}


{{ template "footer" true}}
{{ end }}



{{ define "admin_button_download" }}
			<button
			    type="button"
			    title="{{ tr "admin.tooltip.download" }}"
			    class="btn btn-outline-light btn-sm {{if .CurrentFile.RequiresClientSideDecryption}}disabled{{end}}"
			    onclick="downloadFileWithPresign('{{.CurrentFile.Id }}');">
		   	    <i class="bi bi-download"></i>
			</button>

{{ end }}

{{ define "admin_button_edit" }}
			<button
			    type="button"
			    title="{{ tr "admin.tooltip.edit" }}"
			    {{ if and (ne .ActiveUser.Id .CurrentFile.UploaderId) (not .ActiveUser.HasPermissionEditOtherUploads) }}
			    	disabled
			    {{ end }}
			    class="btn btn-outline-light btn-sm"
			    onclick="showEditModal('{{.CurrentFile.Name }}',
			    	'{{.CurrentFile.Id}}', {{.CurrentFile.DownloadsRemaining }},
			    	 {{.CurrentFile.ExpireAt }}, {{.CurrentFile.IsPasswordProtected}},
			    	 {{.CurrentFile.UnlimitedDownloads }}, {{.CurrentFile.UnlimitedTime}},
			    	 {{.CurrentFile.IsEndToEndEncrypted}},
			    	 {{ or (and (eq .ActiveUser.Id .CurrentFile.UploaderId) (.ActiveUser.HasPermissionReplace))
			    	 	(.ActiveUser.HasPermissionReplaceOtherUploads) }});">
		   	    <i class="bi bi-pencil"></i>
			</button>

{{ end }}


{{ define "admin_button_delete" }}
			<button id="button-delete-{{ .CurrentFile.Id}}"
			   type="button"
			   title="{{ tr "admin.tooltip.delete" }}"
			    {{ if and (ne .ActiveUser.Id .CurrentFile.UploaderId) (not .ActiveUser.HasPermissionDeleteOtherUploads) }}
			    	disabled
			    {{ end }}
			   class="btn btn-outline-danger btn-sm"
			   onclick="deleteFile('{{ .CurrentFile.Id }}')">
			   <i class="bi bi-trash3"></i>
			</button>
{{ end }}

{{ define "admin_button_copyurl" }}
		    <button id="url-button-{{ .CurrentFile.Id }}" type="button" onclick="showToast(1000)"
		    	data-clipboard-text="{{ .CurrentFile.UrlDownload }}" class="copyurl btn btn-outline-light btn-sm" title="{{ tr "admin.tooltip.copyUrl" }}"><i class="bi bi-copy"></i> URL</button>
		    <button type="button" class="btn btn-outline-light btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
		    </button>
			<ul class="dropdown-menu dropdown-menu-end" data-bs-theme="dark" >
	{{ if ne .CurrentFile.UrlHotlink "" }}
			    <li style="cursor: pointer;"><a class="dropdown-item copyurl" title="{{ tr "admin.tooltip.copyHotlink" }}" onclick="showToast(1000)"
			    	data-clipboard-text="{{ .CurrentFile.UrlHotlink }}"><i class="bi bi-copy"></i> {{ tr "admin.label.hotlink" }}</a></li>
		{{ else }}
			    <li><a class="dropdown-item disabled">{{ tr "admin.tooltip.hotlinkNotAvailable" }}</a></li>
	{{ end }}
			</ul>
{{ end }}

{{ define "admin_button_share" }}
		    <button type="button" class="btn btn-outline-light btn-sm" title="{{ tr "admin.tooltip.share" }}" onclick="shareUrl(event, '{{ .CurrentFile.Id }}',
		       '{{ .CurrentFile.UrlDownload }}')">
		       <!-- For some reason bi-share does not always show up, using the svg fixes it -->
		       	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi" viewBox="0 0 16 16">
 				 <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.5 2.5 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5m-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/>
			</svg>
</button>
		    <button type="button" id="shareDropdown-{{ .CurrentFile.Id }}" class="btn btn-outline-light btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
		    </button>
			<ul class="dropdown-menu dropdown-menu-end" data-bs-theme="dark" >
			    <li style="cursor: pointer;"><a class="dropdown-item" id="qrcode-{{ .CurrentFile.Id }}" title="{{ tr "admin.tooltip.qrCode" }}" onclick="showQrCode('{{ .CurrentFile.UrlDownload }}');"><i class="bi bi-qr-code"></i> QR Code</a></li>
			    <li style="cursor: pointer;"><a class="dropdown-item" id="email-{{ .CurrentFile.Id }}" href="mailto:?body={{ .CurrentFile.UrlDownload | urlquery}}"
			       target="_blank" title="{{ tr "admin.tooltip.email" }}"><i class="bi bi-envelope"></i> Email</a></li>
			</ul>
{{ end }}

{{ define "admin_modal_edit" }}

	<div class="modal fade" id="modaledit" tabindex="-1" aria-labelledby="m_filenamelabel" aria-hidden="true">
	  <div class="modal-dialog  modal-lg gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
		<h1 class="modal-title fs-5" id="m_filenamelabel">{{ tr "admin.modal.filename" }}</h1>
	      </div>
	      <div class="modal-body">
		<div class="input-group mb-3">
		  <div class="input-group-text">
      			<input type="checkbox" id="mc_download"  checked aria-label="Limit downloads" title="Limit downloads"  data-toggle-target="mi_edit_down" onchange="handleEditCheckboxChange(this)">
   		 </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_down">{{ tr "admin.modal.limitDownloads" }}</span>
		  <input type="number" min="1" id="mi_edit_down" class="form-control" aria-label="Downloads Remaining" aria-describedby="edit_down" data-allow-regular-paste>
		</div>
		<div class="input-group mb-3">
		  <div class="input-group-text">
      			<input id="mc_expiry" type="checkbox" checked aria-label="Expire files" title="Expire files"  data-toggle-target="mi_edit_expiry" data-timestamp="" onchange="handleEditCheckboxChange(this)" >
   		 </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_expdate">{{ tr "common.expiry" }}</span>
		  <input type="text" id="mi_edit_expiry" class="form-control" aria-label="Expiry" aria-describedby="edit_expdate"  data-allow-regular-paste>
		</div>
		<div class="input-group mb-3">
		  <div class="input-group-text">
      			<input type="checkbox" id="mc_password" aria-label="Require password" title="Require password" data-toggle-target="mi_edit_pw" onchange="handleEditCheckboxChange(this)">
   		 </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_pw">{{ tr "common.password" }}</span>
		  <input type="text" id="mi_edit_pw" class="form-control" aria-label="Password" disabled onclick="selectTextForPw(this)" aria-describedby="edit_pw"  data-allow-regular-paste>
		</div>
		
	      <div class="input-group mb-3" id="replaceGroup">
		  <div class="input-group-text">
		    <input type="checkbox" id="mc_replace" aria-label="Replace file content" title="Replace file content" data-toggle-target="mi_edit_replace" onchange="handleEditCheckboxChange(this)">
		  </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_replace">{{ tr "admin.modal.replaceContent" }}</span>
		  <select id="mi_edit_replace" class="form-select" aria-label="Replace File Content" disabled>
		  </select>
		</div>
	      </div>
	      <div class="modal-footer">
		<button type="button" class="btn btn-outline-light"  aria-label="Close" data-bs-dismiss="modal">{{ tr "common.close" }}</button>
		<button type="button" class="btn btn-primary" data-fileid="" id="mb_save" onclick="editFile();">{{ tr "common.saveChanges" }}</button>
	      </div>
	    </div>
	  </div>
	</div>

{{ end }}
